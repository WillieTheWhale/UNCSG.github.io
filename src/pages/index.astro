---
import "@fontsource/anton/400.css";
import "@fontsource-variable/montserrat";
import "@fontsource-variable/montserrat/wght-italic.css";
import "@fontsource/open-sans/600.css";
import AccessDeniedBanner from "../components/AccessDeniedBanner.astro";
import FeaturedEvent from "../components/FeaturedEvent.astro";
import HomeSections from "../components/HomeSections.astro";
import LaunchWelcome from "../components/LaunchWelcome.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import "../styles/launch-welcome.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="The UNC Student Government Executive Branch website for the Duncan Administration. Find departments, priorities, updates, and public events."
    />
    <meta name="theme-color" content="#13294b" />
    <link rel="canonical" href="https://executivebranch.unc.edu/" />
    <title>UNC Student Government Executive Branch | Duncan Administration</title>
    <script is:inline>
      (() => {
        const storageKey = "uncsg_front_door_welcome_v1";
        try {
          const forceWelcome = new URLSearchParams(window.location.search).get("welcome") === "1";
          if (forceWelcome || window.localStorage.getItem(storageKey) !== "seen") {
            document.documentElement.classList.add("launch-welcome-pending");
          }
        } catch {
          document.documentElement.classList.add("launch-welcome-pending");
        }
      })();
    </script>
    <script
      is:inline
      type="text/javascript"
      id="unc-ub-script"
      data-color="black"
      src="https://unc.edu/web-assets/utility-bar/utility-bar.min.js"
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <AccessDeniedBanner />
    <LaunchWelcome />

    <SiteHeader onHomePage />

    <main id="main">
      <section class="hero" aria-labelledby="page-title" data-featured-event-state="empty">
        <figure class="hero__media hero__media--south-building">
          <img
            src="/images/photo-lab/south-building.webp"
            alt="South Building with Carolina 250 and First and Best for All banners"
            fetchpriority="high"
            decoding="async"
            width="2400"
            height="1604"
          />
        </figure>
        <div class="hero__shade" aria-hidden="true"></div>

        <div class="hero__inner">
          <div class="hero__copy">
            <h1 id="page-title">UNC Student Government Executive Branch</h1>
            <p>The Duncan Administration is creating a Carolina that is first in excellence, best in integrity, and for every student.</p>
          </div>

          <FeaturedEvent />
        </div>
      </section>

      <HomeSections />
    </main>

    <footer class="site-footer" id="contact">
      <div class="site-footer__identity">
        <img
          class="site-footer__signature"
          src="/images/unc-chapel-hill-signature.svg"
          alt="The University of North Carolina at Chapel Hill"
          width="232"
          height="72"
        />
        <strong class="site-footer__title">UNC-Chapel Hill Student Government Executive Branch</strong>
        <p>First, Best, and For All</p>
      </div>
      <div class="site-footer__links">
        <a href="/contact/">Contact Us</a>
        <a href="https://studentgovernment.unc.edu/" rel="nofollow">Student Government Home</a>
        <a href="https://www.instagram.com/unc_executivebranch/">Executive Branch Instagram</a>
        <a href="https://www.instagram.com/sbpdevin/">Student Body President Instagram</a>
        <a href="/manage/">Staff Login</a>
      </div>
    </footer>
  </body>
</html>
