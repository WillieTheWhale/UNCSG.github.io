const newsCoverage = [
  {
    outlet: "Inside Higher Ed",
    date: "July 8, 2026",
    datetime: "2026-07-08",
    title: "UNC Student Body President Devin Duncan on What Students Want",
    href: "https://www.insidehighered.com/podcasts/key-podcast/2026/07/08/ep-203-unc-student-body-president-devin-duncan-what-students-want",
  },
  {
    outlet: "The Daily Tar Heel",
    date: "April 8, 2026",
    datetime: "2026-04-08",
    title: "Devin Duncan sworn in as 2026–27 student body president, wants to ‘deliver consistently’ for students",
    href: "https://www.dailytarheel.com/article/university-devin-duncan-induction-feature-20260408",
  },
  {
    outlet: "Carolina Insider",
    date: "March 11, 2026",
    datetime: "2026-03-11",
    title: "Student body president-elect Devin Duncan joins Carolina Insider",
    href: "https://goheels.com/podcasts/carolina-insider-3-11-26/293",
  },
  {
    outlet: "Morehead-Cain",
