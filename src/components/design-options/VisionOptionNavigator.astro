---
import { visionOptions, visionOptionPath, type VisionOption } from "../../data/vision-options";

interface Props {
  current: VisionOption;
}

const { current } = Astro.props;
const currentIndex = visionOptions.findIndex((option) => option.id === current.id);
const previous = visionOptions[(currentIndex - 1 + visionOptions.length) % visionOptions.length];
const next = visionOptions[(currentIndex + 1) % visionOptions.length];
---

<nav class="vision-lab-nav" aria-label="Vision design option navigator" data-vision-lab-nav>
  <a class="vision-lab-nav__overview" href="/design-options/vision/">All 8 options</a>
  <a
    class="vision-lab-nav__step"
    href={visionOptionPath(previous)}
    aria-label={`Previous option: ${previous.name}`}
    data-previous-option
  >
    ←
  </a>
  <label class="vision-lab-nav__picker">
    <span class="sr-only">Choose a Vision section design option</span>
    <select data-option-picker>
      {visionOptions.map((option) => (
        <option value={visionOptionPath(option)} selected={option.id === current.id}>
          {String(option.id).padStart(2, "0")} · {option.name}
        </option>
      ))}
    </select>
  </label>
  <span class="vision-lab-nav__count" aria-hidden="true">{currentIndex + 1} / {visionOptions.length}</span>
  <a
    class="vision-lab-nav__step"
    href={visionOptionPath(next)}
    aria-label={`Next option: ${next.name}`}
    data-next-option
  >
    →
  </a>
</nav>

<script is:inline>
  (() => {
    const nav = document.querySelector("[data-vision-lab-nav]");
    if (!nav) return;

    nav.querySelector("[data-option-picker]")?.addEventListener("change", (event) => {
      const target = event.currentTarget;
      if (target instanceof HTMLSelectElement) window.location.href = target.value;
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      if (
        target instanceof HTMLButtonElement ||
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        target instanceof HTMLSelectElement ||
        target?.isContentEditable
      ) return;

      if (event.key === "ArrowLeft") {
        const previous = nav.querySelector("[data-previous-option]");
        if (previous instanceof HTMLAnchorElement) window.location.href = previous.href;
      }

      if (event.key === "ArrowRight") {
        const next = nav.querySelector("[data-next-option]");
        if (next instanceof HTMLAnchorElement) window.location.href = next.href;
      }
    });
  })();
</script>
