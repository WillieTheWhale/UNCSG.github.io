---
interface Member {
  name: string;
  title: string;
  email: string;
  major: string;
  hometown: string;
  portrait: string | null;
}

interface Props {
  member: Member;
  mode?: "card" | "row" | "mosaic";
  featured?: boolean;
}

const { member, mode = "card", featured = false } = Astro.props;
const initials = member.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0])
  .join("")
  .toUpperCase();
---

<article class:list={["team-member", `team-member--${mode}`, { "team-member--featured": featured }]}>
  <div class:list={["team-member__portrait", { "team-member__portrait--fallback": !member.portrait }]}>
    {member.portrait ? (
      <img src={member.portrait} alt={`Headshot of ${member.name}`} width="720" height="900" loading="lazy" />
    ) : (
      <span aria-hidden="true">{initials}</span>
    )}
  </div>
  <div class="team-member__content">
    <h3>{member.name}</h3>
    <p class="team-member__role">{member.title}</p>
    {(member.major || member.hometown) && (
      <dl class="team-member__facts">
        {member.major && <div><dt>Major</dt><dd>{member.major}</dd></div>}
        {member.hometown && <div><dt>Hometown</dt><dd>{member.hometown}</dd></div>}
      </dl>
    )}
    <a class="team-member__email" href={`mailto:${member.email}`}>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
        <path d="M3.75 6.75h16.5v10.5H3.75z"></path>
        <path d="m4.5 7.5 7.5 5.75 7.5-5.75"></path>
      </svg>
      <span>{member.email}</span>
    </a>
  </div>
</article>
