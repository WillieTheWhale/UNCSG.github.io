---
import EventCalendarDialog from "./EventCalendarDialog.astro";
---

<section class="content-section content-section--events" id="events" aria-labelledby="events-title">
  <header class="section-heading section-heading--with-link">
    <h2 id="events-title">Events and public meetings</h2>
    <a href="/events/">See all events <span aria-hidden="true">→</span></a>
  </header>
  <div class="event-list" data-home-events aria-live="polite">
    <p class="home-updates-status" data-home-events-status>Loading events…</p>
  </div>
</section>

<EventCalendarDialog />

<script>
  import type { PublicEvent } from "../scripts/event-types";
  import { eventDateParts, eventPlaceLabel } from "../scripts/event-types";

  const list = document.querySelector<HTMLElement>("[data-home-events]");
  const status = document.querySelector<HTMLElement>("[data-home-events-status]");
  if (list && status) {
    fetch("/api/events?scope=upcoming&limit=3", { credentials: "same-origin" })
      .then(async (response) => {
        if (!response.ok) throw new Error("Unable to load events");
        return (await response.json()) as { events: PublicEvent[] };
      })
      .then(({ events }) => {
        if (!events.length) {
          status.textContent = "No upcoming events have been announced yet. Check back soon.";
          return;
        }
        list.replaceChildren(...events.map((event) => {
          const article = document.createElement("article");
          article.className = "event";
          const { day, month } = eventDateParts(event);
          const time = document.createElement("time");
          time.dateTime = event.startAt;
          time.innerHTML = `<b>${day}</b><span>${month}</span>`;
          const copy = document.createElement("div");
          const heading = document.createElement("h3");
          heading.textContent = event.title;
          const detail = document.createElement("p");
          detail.textContent = event.summary || eventPlaceLabel(event);
          copy.append(heading, detail);
          const actions = document.createElement("div");
          actions.className = "event__actions";
          const calendar = document.createElement("button");
          calendar.type = "button";
          calendar.className = "event__calendar";
          calendar.dataset.calendarEvent = "";
          calendar.dataset.eventTitle = event.title;
          calendar.dataset.eventDescription = event.summary || "UNC Student Government Executive Branch event";
          calendar.dataset.eventStart = event.startAt;
          calendar.dataset.eventEnd = event.endAt;
          calendar.dataset.eventAllDay = String(event.allDay);
          calendar.dataset.eventLocation = event.location || "";
          calendar.dataset.eventUrl = `${window.location.origin}/events/${encodeURIComponent(event.slug)}`;
          calendar.setAttribute("aria-haspopup", "dialog");
          calendar.innerHTML = '<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M6.5 3v3M17.5 3v3M4 8.5h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z" /></svg> Add to calendar';
          const details = document.createElement("a");
          details.href = `/events/${encodeURIComponent(event.slug)}`;
          details.setAttribute("aria-label", `Event details: ${event.title}`);
          details.innerHTML = 'Event details <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="m9 6 6 6-6 6" /></svg>';
          actions.append(calendar, details);
          article.append(time, copy, actions);
          return article;
        }));
      })
      .catch(() => {
        status.textContent = "Events could not be loaded right now.";
        const link = document.createElement("a");
        link.href = "/events/";
        link.textContent = "View the events page";
        status.append(" ", link);
      });
  }
</script>
