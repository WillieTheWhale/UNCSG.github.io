PUBLIC_BASE_URL=http://localhost:4321
DATABASE_URL=postgres://uncsg:uncsg@localhost:5432/uncsg_updates
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
API_PORT=8787

# UNC SSO broker. This public URL is not a secret.
UNC_AUTH_BROKER_URL=https://uncsg-auth-broker-bhilberg.apps.cloudapps.unc.edu
UNC_AUTH_BROKER_CLIENT_ID=uncsg-updates

# Run `npm run dev:auth-broker` to exercise the complete local OAuth/PKCE flow
# with the development-only test identity configured in package.json.
BROKER_BASE_URL=http://localhost:8790
BROKER_PORT=8790
MAIN_CLIENT_ID=uncsg-updates
MAIN_REDIRECT_URIS=http://localhost:4321/api/auth/oauth2/callback/unc-openshift

# Microsoft Entra app registration for UNC staff sign-in.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=58b3d54f-16c9-42d3-af08-1fcabd095666

# Leave these blank locally to print sign-in codes in the API terminal.
RESEND_API_KEY=
EMAIL_FROM=Updates Management <manageupdates@sgeb.bennetthilberg.com>
EMAIL_REPLY_TO=bhilberg@unc.edu
