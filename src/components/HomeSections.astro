---

<div class="content-sections">
  <VisionSection />

  <section class="content-section content-section--priorities" id="priorities" aria-labelledby="priorities-title">
    <header class="section-heading">
      <h2 id="priorities-title">Our priorities</h2>
    </header>

    <ol class="priority-list">
      {priorities.map(([number, title, copy, approach, design]) => (
        <li class:list={["priority-card", design]}>
          <span>{number}</span>
          <div>
            <h3>{title}</h3>
            <p>{copy}</p>
            <p class="priority-list__approach"><strong>Our approach:</strong> {approach}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="content-section content-section--departments" id="departments" aria-labelledby="departments-title">
    <header class="section-heading">
      <h2 id="departments-title">Executive offices and cabinet departments</h2>
    </header>

    {directoryGroups.map(({ title, teams }, groupIndex) => (
      <details
        class="directory-group"
        aria-labelledby={`directory-${title.toLowerCase().replaceAll(" ", "-")}`}
        open={groupIndex === 0}
      >
        <summary class="directory-group__summary">
          <h3 class="directory-group__title" id={`directory-${title.toLowerCase().replaceAll(" ", "-")}`}>{title}</h3>
          <span class="directory-group__icon" aria-hidden="true"></span>
        </summary>
        <div class="team-grid">
          {teams.map(({ team, leader, role, email, description, portrait, portraitPosition, initials }) => (
            <article class="team">
              <div class:list={["team__portrait", {
                "team__portrait--fallback": !portrait && initials,
                "team__portrait--empty": !portrait && !initials,
              }]}>
                {portrait ? (
                  <img
                    src={portrait}
                    alt=""
                    width="160"
                    height="160"
                    loading="lazy"
                    decoding="async"
                    style={`object-position: ${portraitPosition};`}
                  />
                ) : initials ? (
                  <span aria-hidden="true">{initials}</span>
                ) : null}
              </div>
              <div class="team__details">
                <h4>{team}</h4>
                <p class="team__description">{description}</p>
                <p class="team__leader"><strong>{leader}</strong><span>{role}</span></p>
              </div>
              <a
                href={`mailto:${email}?subject=${encodeURIComponent(`Executive Branch: ${team}`)}`}
                aria-label={`Email ${team}`}
              >
                <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
                  <path d="M3 5.5h18v13H3zM4 7l8 6 8-6" />
                </svg>
                Email this team
              </a>
            </article>
          ))}
        </div>
      </details>
    ))}
  </section>

  <HomeUpdates />

  <HomeEvents />

  <section class="content-section content-section--news" id="news" aria-labelledby="news-title">
    <header class="section-heading">
      <h2 id="news-title">In the news</h2>
    </header>

    <ul class="news-list">
      {newsCoverage.map(({ outlet, date, datetime, title, href }) => (
        <li>
          <a href={href} target="_blank" rel="noreferrer">
            <span class="news-list__meta">
              <span>{outlet}</span>
              <time datetime={datetime}>{date}</time>
            </span>
            <span class="news-list__title">{title}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="content-section content-section--connected" id="connected" aria-labelledby="connected-title">
    <header class="section-heading">
      <h2 id="connected-title">Stay connected</h2>
    </header>

    <div class="instagram-embed-grid">
      <article
        class="instagram-embed"
        aria-label="UNC Student Government Executive Branch Instagram profile"
        data-instagram-embed-title="UNC Student Government Executive Branch Instagram profile"
      >
        <blockquote
          class="instagram-media"
          data-instgrm-permalink="https://www.instagram.com/unc_executivebranch/"
          data-instgrm-version="14"
        >
          <a href="https://www.instagram.com/unc_executivebranch/" target="_blank" rel="noreferrer">
            View the UNC Student Government Executive Branch on Instagram
          </a>
        </blockquote>
      </article>

      <article
        class="instagram-embed"
        aria-label="Student Body President Instagram profile"
        data-instagram-embed-title="Student Body President Devin Duncan Instagram profile"
      >
        <blockquote
          class="instagram-media"
          data-instgrm-permalink="https://www.instagram.com/sbpdevin/"
          data-instgrm-version="14"
        >
          <a href="https://www.instagram.com/sbpdevin/" target="_blank" rel="noreferrer">
            View Student Body President Devin Duncan on Instagram
          </a>
        </blockquote>
      </article>
    </div>
  </section>
</div>

<script is:inline async src="https://www.instagram.com/embed.js"></script>
<script is:inline>
  (() => {
    const embeds = [...document.querySelectorAll("[data-instagram-embed-title]")];
    const titleInstagramFrames = () => {
      let titledFrames = 0;

      embeds.forEach((embed) => {
        const frame = embed.querySelector("iframe");
        if (!frame) return;
        frame.title = embed.dataset.instagramEmbedTitle;
        titledFrames += 1;
      });

      if (titledFrames === embeds.length) observer.disconnect();
    };

    const observer = new MutationObserver(titleInstagramFrames);
    observer.observe(document.body, { childList: true, subtree: true });
    titleInstagramFrames();
  })();
</script>
