---
import UpdateSiteLayout from "../../layouts/UpdateSiteLayout.astro";
---

<UpdateSiteLayout
  title="Manage Updates | UNC Student Government Executive Branch"
  description="Staff workspace for Executive Branch updates."
  canonicalPath="/manage-updates/"
  noindex
  bodyClass="updates-page manage-updates-page"
>
  <section class="staff-auth" data-staff-auth aria-labelledby="staff-auth-title" aria-busy="true">
    <div class="staff-auth__status">
      <h1 class="visually-hidden" id="staff-auth-title">Manage updates</h1>
      <span class="staff-auth__spinner" aria-hidden="true"></span>
      <p class="staff-form-message" data-auth-message aria-live="polite">Checking your UNC sign-in…</p>
      <button class="staff-button staff-button--secondary" type="button" data-unc-sign-in hidden>
        Try UNC SSO again
      </button>
      <noscript>JavaScript is required to sign in to the updates manager.</noscript>
    </div>
  </section>

  <section class="updates-manager" data-updates-manager hidden aria-label="Updates management workspace">
    <header class="manager-toolbar">
      <div>
        <strong>Manage updates</strong>
      </div>
      <div class="manager-toolbar__actions">
        <a href="/preview-updates/" target="_blank" rel="noopener">View all previews</a>
        <span data-staff-identity></span>
        <button class="staff-link-button" type="button" data-sign-out>Sign out</button>
      </div>
    </header>

    <div class="manager-layout">
      <aside class="manager-sidebar">
        <div class="manager-sidebar__heading">
          <h2>Updates</h2>
          <button class="staff-button staff-button--primary" type="button" data-new-update>
            <span aria-hidden="true">+</span> New update
          </button>
        </div>
        <label class="manager-filter">
          <span>Show</span>
          <select data-status-filter>
            <option value="current">Current updates</option>
            <option value="preview">Preview</option>
            <option value="scheduled">Scheduled</option>
            <option value="published">Published</option>
            <option value="archived">Archived</option>
            <option value="all">All</option>
          </select>
        </label>
        <div class="manager-article-list" data-manager-list aria-live="polite">
          <p class="manager-list-message">Loading updates…</p>
        </div>
      </aside>

      <section class="manager-editor-shell">
        <div class="manager-empty" data-manager-empty>
          <h2>Select an update or start a new one.</h2>
          <p>New work begins in preview, and everything autosaves as you write.</p>
          <button class="staff-button staff-button--primary" type="button" data-empty-new-update>Create an update</button>
        </div>

        <div class="manager-editor" data-manager-editor hidden>
          <header class="manager-editor__statusbar">
            <div class="manager-editor__state">
              <span class="update-status" data-editor-status>preview</span>
              <span data-save-state aria-live="polite">All changes saved</span>
            </div>
            <div class="manager-editor__quiet-actions">
              <button class="staff-link-button manager-archive-button" type="button" data-archive-update>
                <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
                  <path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 4v5m4-5v5"></path>
                </svg>
                <span>Archive</span>
              </button>
            </div>
          </header>

          <div class="manager-fields">
            <label class="manager-title-field">
              <span>Title</span>
              <input type="text" maxlength="180" data-update-title placeholder="Update title" />
            </label>
            <label class="manager-slug-field">
              <span>URL</span>
              <div><span>executivebranch.unc.edu/updates/</span><input type="text" maxlength="120" data-update-slug /></div>
              <small>Lowercase letters, numbers, and hyphens.</small>
            </label>

            <div class="manager-hero-field">
              <div>
                <span class="manager-field-label">Hero image <em>optional</em></span>
                <p>JPEG, PNG, WebP, or GIF. Maximum 5 MB.</p>
              </div>
              <div class="manager-hero-field__actions">
                <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" data-hero-input hidden />
                <button class="staff-button staff-button--secondary" type="button" data-choose-hero>Choose image</button>
                <button class="staff-link-button" type="button" data-remove-hero hidden>Remove</button>
              </div>
              <figure data-hero-preview hidden><img alt="Selected hero image preview" /></figure>
            </div>
          </div>

          <div class="manager-body-field">
            <div class="manager-body-field__heading">
              <div>
                <span class="manager-field-label">Article</span>
                <p>The editor uses the same typography and spacing as the published page.</p>
              </div>
            </div>
            <div class="manager-milkdown" data-markdown-editor></div>
          </div>

          <footer class="manager-publish-bar">
            <button class="staff-button staff-button--secondary" type="button" data-preview-page>Preview full page</button>
            <div class="manager-publish-bar__actions">
              <button class="staff-button staff-button--secondary" type="button" data-publish-now>Publish immediately</button>
              <button class="staff-button staff-button--secondary" type="button" data-open-schedule>Schedule</button>
              <button class="staff-button staff-button--primary" type="button" data-save-preview>Save as preview</button>
            </div>
          </footer>
        </div>
      </section>
    </div>
  </section>

  <dialog class="manager-dialog" data-schedule-dialog aria-labelledby="schedule-title">
    <form method="dialog" class="manager-dialog__panel" data-schedule-form>
      <button class="manager-dialog__close" value="cancel" aria-label="Close scheduling dialog">×</button>
      <h2 id="schedule-title">Schedule this update</h2>
      <p>Choose when this update should become public. All scheduling uses Eastern Time.</p>
      <label>
        <span>Publish date and time</span>
        <input type="datetime-local" data-schedule-at required />
      </label>
      <div class="manager-dialog__actions">
        <button class="staff-button staff-button--secondary" value="cancel">Cancel</button>
        <button class="staff-button staff-button--primary" type="submit" value="default">Schedule update</button>
      </div>
      <p class="staff-form-message" data-schedule-message aria-live="polite"></p>
    </form>
  </dialog>

  <dialog class="manager-dialog manager-confirm-dialog" data-confirm-dialog aria-labelledby="confirm-title" aria-describedby="confirm-message">
    <form method="dialog" class="manager-dialog__panel">
      <button class="manager-dialog__close" value="cancel" aria-label="Close confirmation dialog">×</button>
      <h2 id="confirm-title" data-confirm-title>Confirm action</h2>
      <p id="confirm-message" data-confirm-message></p>
      <div class="manager-dialog__actions">
        <button class="staff-button staff-button--secondary" value="cancel">Cancel</button>
        <button class="staff-button staff-button--primary" value="confirm" data-confirm-accept>Confirm</button>
      </div>
    </form>
  </dialog>

  <div class="manager-toast-region" data-toast-region aria-live="polite" aria-atomic="true"></div>

  <script>
    import "@milkdown/crepe/theme/common/style.css";
    import "@milkdown/crepe/theme/frame.css";
    import { initializeUpdatesManager } from "../../scripts/manage-updates";
    initializeUpdatesManager();
  </script>
</UpdateSiteLayout>
