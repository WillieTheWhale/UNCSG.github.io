{
  "name": "uncsg-executive-branch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:api": "tsx watch server/index.ts",
    "dev:auth-broker": "BROKER_DEV_ONYEN=bhilberg tsx watch auth-broker/index.ts",
    "dev:full": "concurrently -k -n web,api -c blue,green \"npm:dev\" \"npm:dev:api\"",
    "build": "astro build",
    "build:api": "tsc -p tsconfig.server.json",
    "build:auth-broker": "tsc -p tsconfig.auth-broker.json",
    "check": "astro check",
    "preview": "astro preview",
    "start:api": "node dist-server/index.js",
    "test": "node --import tsx --test server/*.test.ts auth-broker/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@milkdown/crepe": "^7.22.0",
    "astro": "^7.2.0",
    "better-auth": "^1.6.27",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "marked": "^18.0.9",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "resend": "^6.19.0",
    "sanitize-html": "^2.17.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.4",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.21.0",
    "@types/sanitize-html": "^2.16.1",
    "concurrently": "^9.2.4",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
