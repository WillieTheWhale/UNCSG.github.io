---
import { ribbonOptions, ribbonOptionPath, type RibbonOption } from "../../data/ribbon-options";

interface Props { current: RibbonOption; }
const { current } = Astro.props;
const currentIndex = ribbonOptions.findIndex((option) => option.id === current.id);
const previous = ribbonOptions[(currentIndex - 1 + ribbonOptions.length) % ribbonOptions.length];
const next = ribbonOptions[(currentIndex + 1) % ribbonOptions.length];
---

<nav class="ribbon-lab-nav" aria-label="Ribbon-cutting design option navigator" data-ribbon-lab-nav>
  <a class="ribbon-lab-nav__overview" href="/design-options/ribbon/">All 10 options</a>
  <a class="ribbon-lab-nav__step" href={ribbonOptionPath(previous)} aria-label={`Previous option: ${previous.name}`} data-previous-option>←</a>
  <label class="ribbon-lab-nav__picker">
    <span class="sr-only">Choose a ribbon-cutting design option</span>
    <select data-option-picker>
      {ribbonOptions.map((option) => (
        <option value={ribbonOptionPath(option)} selected={option.id === current.id}>
          {String(option.id).padStart(2, "0")} · {option.name}
        </option>
      ))}
    </select>
  </label>
  <span class="ribbon-lab-nav__count" aria-hidden="true">{currentIndex + 1} / {ribbonOptions.length}</span>
  <a class="ribbon-lab-nav__step" href={ribbonOptionPath(next)} aria-label={`Next option: ${next.name}`} data-next-option>→</a>
</nav>

<script is:inline>
  (() => {
    const nav = document.querySelector("[data-ribbon-lab-nav]");
    if (!nav) return;
    nav.querySelector("[data-option-picker]")?.addEventListener("change", (event) => {
      const target = event.currentTarget;
      if (target instanceof HTMLSelectElement) window.location.href = target.value;
    });
    document.addEventListener("keydown", (event) => {
      const target = event.target;
      if (target instanceof HTMLButtonElement || target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement || target?.isContentEditable) return;
      if (event.key === "ArrowLeft") window.location.href = nav.querySelector("[data-previous-option]")?.href;
      if (event.key === "ArrowRight") window.location.href = nav.querySelector("[data-next-option]")?.href;
    });
  })();
</script>
